{
  "name": "artist-studio",
  "version": "0.6.5",
  "description": "Gestion de carrière d'artiste : booking, planning, contacts, audience, site web",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "selftest": "ARTIST_SELFTEST=1 electron ."
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.artiststudio.app",
    "productName": "ARTIST Studio",
    "files": [
      "main.js",
      "preload.js",
      "soundcloud.js",
      "reprise.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "ARTIST-Studio-${version}-windows-setup.${ext}"
    },
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FAidN",
        "repo": "ARTISTStudio"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "ARTIST-Studio-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "productName": "ARTIST Studio"
}